# =============================================================================
# dreddiefernandes.com — server configuration (Hostinger / LiteSpeed, Apache-compatible)
#
# Every module-specific block is wrapped in <IfModule> so a missing module never
# causes a 500 error. Keep this file in the repo root (= public_html).
# =============================================================================


# -----------------------------------------------------------------------------
# Basics
# -----------------------------------------------------------------------------

# Custom "page not found" page (absolute path: it can be served at any depth).
ErrorDocument 404 /404.html

# Never list directory contents (e.g. /assets/img/).
Options -Indexes


# -----------------------------------------------------------------------------
# Block private files
# - Dotfiles and dot-directories (.git, .gitignore, .htaccess, .DS_Store ...)
#   are refused with 403, EXCEPT /.well-known/ (needed for SSL certificate
#   validation and similar).
# - Repo-only files: *.md and *.zip.
# -----------------------------------------------------------------------------

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule (^|/)\.(?!well-known(/|$)) - [F,L]
</IfModule>

<FilesMatch "(^\.|\.(md|zip)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>


# -----------------------------------------------------------------------------
# Canonical URLs (301)
# Only applies to the real domain, so local testing (localhost etc.) is untouched.
# Path and query string are preserved.
# -----------------------------------------------------------------------------

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) www -> apex, always onto HTTPS (one hop, also for http://www).
  RewriteCond %{HTTP_HOST} ^www\.dreddiefernandes\.com$ [NC]
  RewriteRule ^ https://dreddiefernandes.com%{REQUEST_URI} [R=301,L]

  # 2) HTTP -> HTTPS on the apex. The X-Forwarded-Proto check avoids a redirect
  #    loop if a CDN/proxy in front of the server terminates TLS.
  RewriteCond %{HTTP_HOST} ^dreddiefernandes\.com$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://dreddiefernandes.com%{REQUEST_URI} [R=301,L]

  # 3) /index.html -> /  (THE_REQUEST is the raw request line sent by the
  #    browser, so the internal DirectoryIndex lookup for "/" never loops.)
  RewriteCond %{THE_REQUEST} ^[A-Z]+\s/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]
</IfModule>


# -----------------------------------------------------------------------------
# Security headers
# The CSP assumes fonts are self-hosted (no Google Fonts), all scripts are
# external files under /assets/ (JSON-LD blocks are not executed, so they need
# no script-src allowance) and pages use inline style="" attributes.
# -----------------------------------------------------------------------------

<IfModule mod_headers.c>
  # HSTS: 1 year, this host only. No includeSubDomains / preload on purpose.
  # (Browsers ignore this header on plain-HTTP responses.)
  Header always set Strict-Transport-Security "max-age=31536000"

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'self'; base-uri 'self'; form-action 'self' mailto:; upgrade-insecure-requests"
</IfModule>


# -----------------------------------------------------------------------------
# MIME types (for formats older server configs may not know)
# -----------------------------------------------------------------------------

<IfModule mod_mime.c>
  AddType image/avif      .avif
  AddType image/webp      .webp
  AddType image/svg+xml   .svg
  AddType font/woff2      .woff2
  AddType font/woff       .woff
  AddType application/xml .xml
  AddCharset utf-8 .html .css .js .json .xml .txt .svg
</IfModule>


# -----------------------------------------------------------------------------
# Browser caching
# Filenames are not content-hashed, so assets get moderate lifetimes:
#   HTML        -> always revalidate (edits show up immediately)
#   CSS / JS    -> 7 days
#   images/fonts-> 30 days
# -----------------------------------------------------------------------------

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 hour"

  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType application/xml           "access plus 1 day"
  ExpiresByType text/xml                  "access plus 1 day"
  ExpiresByType text/plain                "access plus 1 day"

  ExpiresByType text/css                  "access plus 7 days"
  ExpiresByType application/javascript    "access plus 7 days"
  ExpiresByType text/javascript           "access plus 7 days"

  ExpiresByType image/avif                "access plus 30 days"
  ExpiresByType image/webp                "access plus 30 days"
  ExpiresByType image/png                 "access plus 30 days"
  ExpiresByType image/jpeg                "access plus 30 days"
  ExpiresByType image/gif                 "access plus 30 days"
  ExpiresByType image/svg+xml             "access plus 30 days"
  ExpiresByType image/x-icon              "access plus 30 days"
  ExpiresByType font/woff2                "access plus 30 days"
  ExpiresByType font/woff                 "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  # HTML: browser may store it but must revalidate (ETag/Last-Modified) every time.
  <FilesMatch "\.html?$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>


# -----------------------------------------------------------------------------
# Compression (gzip) for text-based responses
# -----------------------------------------------------------------------------

<IfModule mod_deflate.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml
    AddOutputFilterByType DEFLATE application/javascript text/javascript
    AddOutputFilterByType DEFLATE application/json application/ld+json image/svg+xml
  </IfModule>
</IfModule>
